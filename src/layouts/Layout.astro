---
interface Props {
	title?: string;
}

const { title = "Hola :D — Edwin Rodriguez" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts: Plus Jakarta Sans for crisp modern geometric typography -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

		<!-- Inline script to prevent FOUC when switching dark/light mode -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #fbfbfa;
		--color-text: #111113;
		--color-text-strong: #000000;
		--color-muted: #5e5e66;
		--color-border: #e4e4e7;
		--color-card-hover: rgba(0, 0, 0, 0.03);
		
		--color-footer-bg: #0d0d0f;
		--color-footer-text: #ffffff;
		--color-footer-muted: #9ca3af;
		--color-footer-border: #222226;

		--font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}

	html.dark {
		--color-bg: #0e0e10;
		--color-text: #ffffff;
		--color-text-strong: #ffffff;
		--color-muted: #a1a1aa;
		--color-border: #27272a;
		--color-card-hover: rgba(255, 255, 255, 0.04);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		font-family: var(--font-sans);
		background-color: var(--color-bg);
		color: var(--color-text);
		transition: background-color 0.25s ease, color 0.25s ease;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow-x: hidden;
		line-height: 1.5;
		background-color: var(--color-bg);
		color: var(--color-text);
	}

	::selection {
		background-color: var(--color-text);
		color: var(--color-bg);
	}

	/* Scrollbar */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: #d1d1d6;
		border-radius: 3px;
	}
	html.dark ::-webkit-scrollbar-thumb {
		background: #2c2c32;
	}
</style>
