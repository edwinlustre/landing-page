<nav class="bottom-bar" aria-label="Navegación principal">
	<a class="brand-mark" href="#inicio" aria-label="Ir al inicio">ER</a>
	<div class="nav-links"><a href="#inicio">Inicio</a><a href="#links">Enlaces</a><a href="#juego">Juego</a><a href="#contacto">Contacto</a></div>
	<button id="themeToggleBtn" class="theme-toggle" aria-label="Cambiar tema oscuro" title="Cambiar tema"><span id="themeIcon" aria-hidden="true">☾</span></button>
</nav>
<script>
	const themeToggleBtn = document.getElementById('themeToggleBtn');
	const themeIcon = document.getElementById('themeIcon');
	function updateThemeButton() {
		const isDark = document.documentElement.classList.contains('dark');
		if (themeIcon) themeIcon.textContent = isDark ? '☀' : '☾';
		if (themeToggleBtn) themeToggleBtn.setAttribute('aria-label', isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
	}
	updateThemeButton();
	themeToggleBtn?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		updateThemeButton();
	});
	const footer = document.getElementById('contacto');
	const bottomBar = document.querySelector('.bottom-bar');
	if (footer && bottomBar && 'IntersectionObserver' in window) {
		const footerObserver = new IntersectionObserver(([entry]) => {
			bottomBar.classList.toggle('is-hidden', entry.isIntersecting);
		}, { threshold: 0.01 });
		footerObserver.observe(footer);
	}
</script>
<style>
	.bottom-bar { position: fixed; z-index: 100; left: 50%; bottom: max(1.25rem, env(safe-area-inset-bottom)); transform: translateX(-50%); display: flex; align-items: center; gap: 1.25rem; padding: .65rem .75rem; border: 1px solid var(--color-border); border-radius: 999px; background: rgba(var(--color-bg-rgb), .88); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 12px 40px rgba(0,0,0,.13); transition: transform .28s ease, opacity .22s ease; }
	.bottom-bar.is-hidden { transform: translate(-50%, calc(100% + 2rem)); opacity: 0; pointer-events: none; }
	.brand-mark { display: grid; place-items: center; flex: 0 0 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--color-text); color: var(--color-bg); font-size: .72rem; font-weight: 800; letter-spacing: -.04em; text-decoration: none; }
	.nav-links { display: flex; align-items: center; gap: .25rem; }
	.nav-links a { padding: .55rem .75rem; border-radius: 999px; color: var(--color-muted); font-size: .8rem; font-weight: 600; text-decoration: none; transition: .2s ease; }
	.nav-links a:hover, .nav-links a:focus-visible { color: var(--color-text); background: var(--color-card-hover); }
	.theme-toggle { width: 2.25rem; height: 2.25rem; border: 0; border-radius: 50%; background: var(--color-card-hover); color: var(--color-text); cursor: pointer; font: 600 1.05rem var(--font-sans); }
	@media (max-width: 540px) { .bottom-bar { width: calc(100% - 1.5rem); bottom: max(.65rem, env(safe-area-inset-bottom)); justify-content: space-between; gap: .3rem; padding: .45rem .55rem; } .nav-links { flex: 1; justify-content: space-around; gap: 0; } .nav-links a { padding: .55rem .42rem; font-size: .72rem; } }
	@media (max-width: 360px) { .nav-links a { font-size: .67rem; padding-inline: .3rem; } }
</style>
