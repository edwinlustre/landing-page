---
// Footer — giant Hablemos. + 3-part balanced bottom bar
---

<footer class="footer" id="contacto">
	<div class="footer-inner">
		<!-- Contact line: simple, direct -->
		<div class="footer-contact">
			<span class="contact-label">Contacto</span>
			<a href="mailto:edwin51092@hotmail.com" class="contact-email">
				edwin51092@hotmail.com
			</a>
		</div>

		<!-- Giant Wordmark -->
		<div class="wordmark-wrap">
			<h2 class="wordmark" id="footerWordmark">Hablemos.</h2>
		</div>

		<!-- Bottom bar: Author | Web Credit | Copyright -->
		<div class="footer-bottom">
			<span class="footer-name">Edwin Rodriguez</span>
			
			<span class="pixel-credit">sitio hecho a mano con bytes reciclados</span>
			
			<span class="footer-copy">© {new Date().getFullYear()}</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		background-color: #0d0d0f;
		color: #ffffff;
		width: 100%;
		margin-top: auto;
		border-top: 1px solid #1a1a1f;
		overflow: hidden;
		position: relative;
		z-index: 10;
	}

	.footer-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 5rem 2rem 2.5rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	/* Contact line */
	.footer-contact {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-bottom: 3.5rem;
	}

	.contact-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #71717a;
	}

	.contact-email {
		color: #ffffff;
		text-decoration: none;
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		opacity: 0.9;
		transition: opacity 0.2s ease;
		display: inline-block;
	}

	.contact-email:hover { opacity: 0.65; }

	/* Giant Wordmark */
	.wordmark-wrap {
		width: 100%;
		overflow: hidden;
		padding-bottom: 3rem;
	}

	.wordmark {
		font-size: clamp(2.3rem, 11vw, 9.5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
		color: #ffffff;
		white-space: nowrap;
		margin: 0;
		user-select: none;
		transition: opacity 0.3s ease;
		cursor: default;
	}

	.wordmark:hover { opacity: 0.88; }

	/* Bottom bar */
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 2rem;
		border-top: 1px solid #1a1a1f;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.footer-name {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.pixel-credit {
		font-family: var(--font-pixel);
		font-size: 0.58rem;
		color: #71717a;
		letter-spacing: 0.05em;
		line-height: 1.5;
		text-align: center;
	}

	.footer-copy {
		font-size: 0.88rem;
		color: #52525b;
	}

	@media (max-width: 768px) {
		.footer-inner { padding: 3.5rem 1.5rem 2rem 1.5rem; }
		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}
		.pixel-credit {
			text-align: left;
		}
	}
</style>
