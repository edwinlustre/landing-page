---
// Antigravity.google inspired Footer with balanced layout, complete wordmark, and clean non-repetitive links
---

<footer class="antigravity-footer" id="contacto">
	<div class="footer-inner">
		<!-- Top footer area: concise message & direct action -->
		<div class="footer-top">
			<div class="footer-callout">
				<span class="callout-tag">Contacto directo</span>
				<p class="callout-text">
					¿Tienes una propuesta, proyecto o vacante en mente? Hablemos.
				</p>
			</div>

			<div class="footer-direct-actions">
				<div class="email-box">
					<span class="box-label">Correo electrónico</span>
					<div class="email-action-row">
						<a href="mailto:edwin51092@hotmail.com" class="email-link">edwin51092@hotmail.com</a>
						<button class="mini-copy-btn" id="footerCopyBtn" title="Copiar correo">
							<span id="footerCopyText">Copiar</span>
						</button>
					</div>
				</div>

				<div class="location-box">
					<span class="box-label">Ubicación & Disponibilidad</span>
					<span class="location-text">México (UTC-6) • Remoto / Híbrido</span>
				</div>
			</div>
		</div>

		<!-- Giant Wordmark Section: perfectly fitted so "Sigamos en contacto" is 100% visible -->
		<div class="wordmark-container">
			<h2 class="giant-wordmark">Sigamos en contacto</h2>
		</div>

		<!-- Bottom Bar -->
		<div class="footer-bottom-bar">
			<div class="brand-signature">
				<span>Edwin Rodriguez</span>
			</div>
			
			<div class="bottom-links">
				<a href="https://github.com/edwinlustre" target="_blank" rel="noopener noreferrer" class="bottom-link">GitHub</a>
				<a href="https://www.linkedin.com/in/edwin-lustre-rodriguez-24b3613ab" target="_blank" rel="noopener noreferrer" class="bottom-link">LinkedIn</a>
				<span class="bottom-copyright">© {new Date().getFullYear()}</span>
			</div>
		</div>
	</div>
</footer>

<script>
	const footerCopyBtn = document.getElementById('footerCopyBtn');
	const footerCopyText = document.getElementById('footerCopyText');

	if (footerCopyBtn && footerCopyText) {
		footerCopyBtn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText('edwin51092@hotmail.com');
				footerCopyText.textContent = '¡Copiado!';
				footerCopyBtn.classList.add('copied');
				setTimeout(() => {
					footerCopyText.textContent = 'Copiar';
					footerCopyBtn.classList.remove('copied');
				}, 2000);
			} catch (e) {
				footerCopyText.textContent = 'Error';
			}
		});
	}
</script>

<style>
	/* Antigravity-inspired dark grey footer */
	.antigravity-footer {
		background-color: #0d0d0f; /* Deep sleek dark grey */
		color: #ffffff;
		width: 100%;
		margin-top: auto;
		border-top: 1px solid #1f1f24;
		overflow: hidden;
	}

	.footer-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 5rem 2rem 2.5rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	/* Top section */
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 2.5rem;
	}

	.footer-callout {
		max-width: 380px;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.callout-tag {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #9ca3af;
	}

	.callout-text {
		font-size: 1.08rem;
		line-height: 1.55;
		color: #e4e4e7;
		letter-spacing: -0.01em;
	}

	.footer-direct-actions {
		display: flex;
		gap: 3.5rem;
		flex-wrap: wrap;
	}

	.email-box, .location-box {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.box-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #9ca3af;
	}

	.email-action-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.email-link {
		color: #ffffff;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		transition: opacity 0.2s ease;
	}

	.email-link:hover {
		opacity: 0.75;
	}

	.location-text {
		color: #d1d1d6;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
	}

	.mini-copy-btn {
		background: #1e1e24;
		color: #d1d1d6;
		border: 1px solid #2e2e38;
		border-radius: 9999px;
		padding: 0.25rem 0.65rem;
		font-size: 0.74rem;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mini-copy-btn:hover {
		background: #ffffff;
		color: #000000;
		border-color: #ffffff;
	}

	.mini-copy-btn.copied {
		background: #10b981;
		color: #ffffff;
		border-color: #10b981;
	}

	/* Giant Wordmark Section - Fitted precisely so it never gets cut off */
	.wordmark-container {
		width: 100%;
		padding: 1.5rem 0 0.5rem 0;
		overflow: hidden;
		display: flex;
		align-items: center;
	}

	.giant-wordmark {
		/* Scale with container width so it fits on 1 line without cutting letters */
		font-size: clamp(2rem, 6.7vw, 5.8rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
		color: #ffffff;
		white-space: nowrap;
		margin: 0;
		user-select: none;
		transition: opacity 0.25s ease;
	}

	.giant-wordmark:hover {
		opacity: 0.9;
	}

	/* Bottom Bar */
	.footer-bottom-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-top: 2rem;
		border-top: 1px solid #1f1f24;
	}

	.brand-signature {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.bottom-links {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.bottom-link {
		color: #9ca3af;
		text-decoration: none;
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		transition: color 0.2s ease;
	}

	.bottom-link:hover {
		color: #ffffff;
	}

	.bottom-copyright {
		color: #6b7280;
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.footer-inner {
			padding: 3.5rem 1.5rem 2rem 1.5rem;
			gap: 2.5rem;
		}
		.footer-top {
			flex-direction: column;
			gap: 2rem;
		}
		.footer-direct-actions {
			flex-direction: column;
			gap: 1.5rem;
		}
		.footer-bottom-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		.bottom-links {
			gap: 1.25rem;
		}
	}
</style>
