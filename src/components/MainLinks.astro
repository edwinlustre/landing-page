---
// Antigravity-inspired Main Links list — frosted backdrop for game readability
const links = [
	{
		title: "Portfolio Web",
		description: "Proyectos, experiencia y stack tecnológico a detalle.",
		href: "https://portfolio.edwinlst.tech",
		meta: "Explorar",
	},
	{
		title: "GitHub",
		description: "Código fuente, contribuciones y proyectos personales.",
		href: "https://github.edwinlst.tech",
		meta: "@edwinlustre",
	},
	{
		title: "LinkedIn",
		description: "Perfil profesional y trayectoria.",
		href: "https://linkedin.edwinlst.tech",
		meta: "Conectar",
	},
	{
		title: "Correo Electrónico",
		description: "Escríbeme directamente.",
		href: "mailto:edwin51092@hotmail.com",
		meta: "Mensaje directo",
	},
];
---

<section class="links-section">
	<div class="links-wrapper">
		<div class="section-tag">Links</div>

		<div class="links-list">
			{links.map((link) => (
				<a 
					href={link.href}
					target={link.href.startsWith("http") ? "_blank" : undefined}
					rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
					class="link-row"
				>
					<div class="link-main">
						<span class="link-title">{link.title}</span>
						<span class="link-desc">{link.description}</span>
					</div>
					<div class="link-side">
						<span class="link-meta">{link.meta}</span>
						<span class="link-arrow">↗</span>
					</div>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.links-section {
		position: relative;
		z-index: 10;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem 6rem 2rem;
		width: 100%;
	}

	.links-wrapper {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;

		/* Frosted backdrop matching hero */
		background: rgba(var(--color-bg-rgb), 0.82);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		border-radius: 1.25rem;
		border: 1px solid var(--color-border);
		padding: 2rem 2.25rem;
	}

	.section-tag {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: var(--color-muted);
	}

	.links-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border);
	}

	.link-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.4rem 0.35rem;
		border-bottom: 1px solid var(--color-border);
		text-decoration: none;
		color: inherit;
		gap: 1.5rem;
		border-radius: 4px;
		transition: background-color 0.2s ease;
	}

	.link-row:hover {
		background-color: var(--color-card-hover);
	}

	.link-main {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.link-title {
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-text);
		transition: color 0.25s ease;
	}

	.link-desc {
		font-size: 0.88rem;
		color: var(--color-muted);
		line-height: 1.4;
		transition: color 0.25s ease;
	}

	.link-side {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	.link-meta {
		font-size: 0.82rem;
		color: var(--color-muted);
		font-weight: 500;
	}

	.link-arrow {
		font-size: 1.25rem;
		color: var(--color-text);
		transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.link-row:hover .link-arrow {
		transform: translate(3px, -3px);
	}

	@media (max-width: 640px) {
		.links-section { padding: 0 1.25rem 5rem 1.25rem; }
		.links-wrapper { padding: 1.5rem 1.25rem; border-radius: 1rem; }
		.link-row { flex-direction: column; align-items: flex-start; gap: 0.6rem; padding: 1.2rem 0.25rem; }
		.link-side { width: 100%; justify-content: space-between; }
	}
</style>
